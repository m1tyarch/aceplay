#!/usr/bin/env bash
set -euo pipefail

CONTAINER_NAME="${ACESTREAM_CONTAINER:-acestream}"
HTTP_PORT="${ACESTREAM_PORT:-6878}"
HOST="localhost"
container_started=0
spinner_pid=""

# Stop spinner animation, clear line and restore cursor
stop_spinner() {
	if [[ -n "$spinner_pid" ]]; then
		kill "$spinner_pid" 2>/dev/null || true
		wait "$spinner_pid" 2>/dev/null || true
		spinner_pid=""
		if [[ -t 2 ]]; then
			printf '\r\033[K\e[?25h' >&2
		fi
	fi
}

# Display a single in-place status line with animated spinner
spin() {
	local msg="$1"
	if [[ ! -t 2 ]]; then
		echo "$msg" >&2
		return
	fi

	if [[ -n "$spinner_pid" ]]; then
		kill "$spinner_pid" 2>/dev/null || true
		wait "$spinner_pid" 2>/dev/null || true
	fi

	printf '\e[?25l' >&2
	(
		local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
		local i=0
		while true; do
			printf '\r\033[K%s %s' "${frames[i]}" "$msg" >&2
			i=$(((i + 1) % 10))
			sleep 0.08
		done
	) &
	spinner_pid=$!
}

# Cleanup handler: stop spinner and container on exit or interrupt
cleanup() {
	stop_spinner
	if ((container_started)); then
		(docker stop -t 1 "$CONTAINER_NAME" >/dev/null 2>&1 &)
	fi
}
trap cleanup EXIT INT TERM

# Function to clean stream hash using pure bash string manipulation
clean_stream_hash() {
	local input="$1"
	# Strip leading/trailing whitespace
	input="${input#"${input%%[![:space:]]*}"}"
	input="${input%"${input##*[![:space:]]}"}"
	# Strip acestream:// URI prefix
	input="${input#acestream://}"
	echo "$input"
}

raw_input="${1:-}"

# Auto-detect from clipboard (Wayland wl-paste or X11 xclip) if no argument provided
if [[ -z "$raw_input" ]]; then
	clip_content=""
	if command -v wl-paste >/dev/null 2>&1; then
		clip_content="$(wl-paste --no-newline 2>/dev/null || true)"
	elif command -v xclip >/dev/null 2>&1; then
		clip_content="$(xclip -selection clipboard -o 2>/dev/null || true)"
	fi

	candidate="$(clean_stream_hash "$clip_content")"
	# Check if clipboard contains a valid 40-character hex hash
	if [[ "$candidate" =~ ^[a-fA-F0-9]{40}$ ]]; then
		spin "Clipboard hash detected: ${candidate:0:10}..."
		raw_input="$candidate"
		sleep 0.2
	fi
fi

# Fallback to interactive prompt if still empty
if [[ -z "$raw_input" ]]; then
	stop_spinner
	echo -n "Paste Ace Stream HASH or link and press Enter: "
	read -r raw_input
fi

clean_hash="$(clean_stream_hash "$raw_input")"

if [[ -z "$clean_hash" ]]; then
	stop_spinner
	echo "Error: stream hash is empty." >&2
	exit 1
fi

spin "Checking Ace Stream container..."

# Check if container is already running
if docker ps --format '{{.Names}}' | grep -qw "^${CONTAINER_NAME}$"; then
	spin "Ace Stream engine running, preparing stream..."
else
	spin "Starting Ace Stream engine..."
	if ! docker start "$CONTAINER_NAME" >/dev/null 2>&1; then
		stop_spinner
		echo "Error: Docker daemon is not running or container '$CONTAINER_NAME' not found." >&2
		echo "Make sure Docker is running: sudo systemctl enable --now docker.socket" >&2
		exit 1
	fi
	container_started=1

	spin "Connecting to Ace Stream API..."
	# Fast poll HTTP API for readiness (0.1s interval, timeout: 15s)
	attempts=0
	until curl -s "http://${HOST}:${HTTP_PORT}" >/dev/null 2>&1; do
		sleep 0.1
		attempts=$((attempts + 1))
		if ((attempts >= 150)); then
			stop_spinner
			echo "Error: Ace Stream engine failed to respond on port ${HTTP_PORT} within 15 seconds." >&2
			exit 1
		fi
	done
fi

stream_url="http://${HOST}:${HTTP_PORT}/ace/getstream?id=${clean_hash}"
short_hash="${clean_hash:0:10}..."

spin "Starting mpv..."
sleep 0.15
stop_spinner

mpv \
	--no-resume-playback \
	--title="Ace Stream: ${short_hash}" \
	--hwdec=vaapi \
	--profile=fast \
	--msg-level=ffmpeg=fatal \
	--cache=yes \
	--cache-pause-wait=2 \
	--force-seekable=yes \
	--demuxer-max-bytes=200M \
	--demuxer-readahead-secs=30 \
	--cache-secs=30 \
	"$stream_url"
